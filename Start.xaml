<Page x:Class="OOD_project_2026.Start"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OOD_project_2026"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Start">

    <Grid x:Name="StartWindow">

        <Grid Background="White">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!--Title and setting -->
            <Border Grid.Column="0" Grid.ColumnSpan ="2" Background="DarkGreen" BorderBrush="Black" BorderThickness="5">
                <TextBlock Text="Bolatro" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FFED1010" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </Border>
            <Border Grid.Column="0" Grid.ColumnSpan ="2">
                <TextBlock Text="The House always Wins" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" FontWeight="Bold" FontStyle="Italic" Margin="0,107,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FFED1010" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground></TextBlock>
            </Border>

            <Grid>

            </Grid>
            <!--Submitting a name to continue-->
            <Grid Grid.Column="1" Grid.Row="2">
                <TextBox x:Name="PlayerNameSubmission" Text ="Enter a name to continue" Height="20" Width="240" GotFocus="PlayerNameSubmission_GotFocus"/>
                <Button x:Name="SubmitContent" Content="Submit" Height="20" Width="120" Margin="140,90,140,40" Click="SumbitName"/>
            </Grid>
            <!--Leaving this as non clickable until the player has inputted their name-->
            <Button Grid.Column="0" Grid.Row="1" x:Name="StartGame" Background="#FFEAE21D"  Content="Start Game" Click="StartGame_Click" Height="34" Width="97" IsHitTestVisible="False" Visibility="Visible"/>

            <TextBlock Grid.Column="1" Grid.Row="1" Text="HighScores" FontWeight="Bold" HorizontalAlignment="Center"/>
            <ListBox Grid.Column="1" Grid.Row="1" Margin="10,20,10,0" x:Name="PlayerNameList" Background="DarkGreen" FontSize="14" FontWeight="Bold">
                <ListBoxItem Content="Player 1:    Score:   Date:" x:Name="Player1" Background="Red"></ListBoxItem>
                <ListBoxItem Content="Player 2:    Score:   Date:" x:Name="Player2" Background="Green"></ListBoxItem>
                <ListBoxItem Content="Player 3:    Score:   Date:" x:Name="Player3" Background="Blue"></ListBoxItem>
                <ListBoxItem Content="Player 4:    Score:   Date:" x:Name="Player4" Background="Yellow"></ListBoxItem>
            </ListBox>
        </Grid>


    </Grid>
</Page>
