<Page x:Class="OOD_project_2026.Start"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OOD_project_2026"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1200"
      Title="Start"
      Loaded="Window_Loaded">

    <Grid Background="#0E1621">
        <Grid.Margin>
            <Thickness>30</Thickness>
        </Grid.Margin>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Grid.Column="0"
                Background="#0F2233"
                CornerRadius="18"
                Padding="30"
                Margin="0,0,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.1*"/>
                </Grid.RowDefinitions>

                <!-- Title card -->
                <Border Grid.Row="0"
                        Background="#102A1D"
                        CornerRadius="16"
                        BorderBrush="#1E3D2A"
                        BorderThickness="2"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bolatro"
                                   HorizontalAlignment="Center"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Margin="0,10,0,8">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF5A5A" Offset="0"/>
                                    <GradientStop Color="#B30000" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <TextBlock Text="The House Always Wins"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontStyle="Italic"
                                   FontWeight="SemiBold"
                                   Foreground="#D96C6C"/>
                    </StackPanel>
                </Border>

                <!-- Start button section -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Ready to play?"
                               Foreground="#DCE6F2"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18"/>

                    <Button x:Name="StartGame"
                            Content="Start Game"
                            Click="StartGame_Click"
                            Width="180"
                            Height="55"
                            FontSize="18"
                            FontWeight="Bold"
                            Background="#FFA5A5A5"
                            Foreground="#FFD6CFCF"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsHitTestVisible="False"/>
                </StackPanel>

                <!-- Name entry -->
                <Border Grid.Row="2"
                        Background="#4B2D1F"
                        CornerRadius="16"
                        BorderBrush="#8B5A3C"
                        BorderThickness="2"
                        Padding="24"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Enter your name"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <TextBox x:Name="PlayerNameSubmission"
                                 Text="Enter a name to continue"
                                 Height="38"
                                 Width="280"
                                 FontSize="15"
                                 Padding="10,6"
                                 HorizontalAlignment="Center"
                                 GotFocus="PlayerNameSubmission_GotFocus"/>

                        <Button x:Name="SubmitContent"
                                Content="Submit"
                                Width="140"
                                Height="42"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#E5E7EB"
                                Foreground="Black"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SumbitName"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT SIDE -->
        <Border Grid.Column="1"
                Background="#1B3145"
                CornerRadius="18"
                BorderBrush="#D9E6F2"
                BorderThickness="2"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="High Scores"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Column headers -->
                <Border Grid.Row="1"
                        Background="#243F57"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="#" Foreground="#DDE7F1" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Player" Foreground="#DDE7F1" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Score" Foreground="#DDE7F1" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="Rounds" Foreground="#DDE7F1" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="Date" Foreground="#DDE7F1" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2"
                         Name="PlayerNameList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#243F57"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                    <Setter Property="Background" Value="Gold"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                    <Setter Property="Background" Value="Silver"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                    <Setter Property="Background" Value="#CD7F32"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10"
                                    Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Rank}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PlayerName}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding HighScore}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding RoundsLasted}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Date, StringFormat=d}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>