<Page x:Class="OOD_project_2026.MainGamePlayWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:OOD_project_2026"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MainGamePlayWindow">

    <Grid Background="#0E1621">
        <Grid x:Name="MainGrid" Loaded="MainGrid_Loaded">

           <!--#region  Main Window and groups-->
            <Grid x:Name="MainGameplayScreen" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width=".3*" />
                </Grid.ColumnDefinitions>
                
                <!--Changed these to brrders to get rounded edges. -->
                <Border Grid.Row="0" Grid.Column="0" Background="#1B5E20"> 
                    <!--Main title text-->
                    <TextBlock Grid.Column="0" Text="Bolatro" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#18364D" Margin="8,8,8,4" CornerRadius="10"/>
                <Border Grid.Row="0" Grid.Column="2" Background="#4B2D1F" Margin="8,8,8,4" CornerRadius="10"/>

                <Grid Grid.Row="0" Grid.Column="2" x:Name="ArcanaCardsOwned">
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions> 
                    
                    <TextBlock Text="Arcana cards" Grid.ColumnSpan="2" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />

                    <Button x:Name="PlayerArcanaCardsOwned1" Grid.Row="1" Margin="15" ></Button>
                    <Button x:Name="PlayerArcanaCardsOwned2" Grid.Row="1" Grid.Column="1" Margin="14"></Button>
                    </Grid>  
               
                <!-- Changed this but initally this was the joker card grid. -->
                <TextBlock Grid.Column="1" Grid.Row="0" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" />
                <!--This is where you can select the arcana cards, now Ive yet to do them but it should be grand -->
               

              
                <!--Quitgame button.-->
                <Border Grid.Row="3"  Grid.Column="0"  Background="#1B5E20" Margin="8" CornerRadius="10">
                    <Button x:Name="QuitButton" Content="Quit Game" Foreground="White"  FontWeight="Bold"  FontSize="16"  HorizontalAlignment="Center" Click="QuitButton_Click" VerticalAlignment="Center" Background="#00A5A5A5" />
                </Border>
                <!--#region Joker Cards Owned-->
                <!-- Owned joker row -->
                <Border x:Name="OwnedJokerBar" Grid.Row="0" Grid.Column="1" Margin="8,8,8,4" Background="#D61A2B3C" BorderBrush="#FFE6EEF8" BorderThickness="1.5" CornerRadius="12" Panel.ZIndex="5000" Visibility="Visible">

                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>



                        <Grid x:Name="JokerCardsOwned" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="OwnedJoker1" Grid.Column="0" Height="150" Click="OwnedJoker_Click"/>
                            <Button x:Name="OwnedJoker2" Grid.Column="2" Height="150" Click="OwnedJoker_Click"/>
                            <Button x:Name="OwnedJoker3" Grid.Column="4" Height="150" Click="OwnedJoker_Click"/>
                            <Button x:Name="OwnedJoker4" Grid.Column="6" Height="150" Click="OwnedJoker_Click"/>
                            <Button x:Name="OwnedJoker5" Grid.Column="8" Height="150" Click="OwnedJoker_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <!--#endregion-->
                <!--Sub groups-->
                <Grid Grid.Column="0" Grid.Row="2" Margin="8">
                    <Border Background="#22354A" CornerRadius="10"/>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width=".25*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width=".25*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Background="#1A2740" CornerRadius="6"/>
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Background="#1A2740" CornerRadius="6"/>

                        <!--Hands and diguards left disaply-->
                        <TextBlock x:Name="HandsLeft" Grid.Row="1" Grid.Column="2" Text="0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Padding="8,4" FontWeight="Bold"/>
                        <TextBlock x:Name="DisguardsLeft" Grid.Row="3" Grid.Column="2" Text="0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Padding="8,4" FontWeight="Bold"/>
                        <TextBlock Text="Hands left" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#C62828" Foreground="White" Padding="8,4" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Disguards left" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#1565C0"  Foreground="White" Padding="8,4" FontSize="12" FontWeight="Bold"/>
                       
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Grid.Column="2" Margin="8" Background="#3A2F1D" CornerRadius="10">
                    <TextBlock x:Name="DeckArea"  Text="Deck" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!--TextBlock colouring for the mult-->
                <Grid Grid.Row="1" Grid.Column="0" Margin="8">
                    <Border Background="#22354A" CornerRadius="10"/>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!--Displaying blind score-->
                        <TextBlock Background="#22354A" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"/>
                        <TextBlock x:Name="BlindScoreDisplay" Text="0" Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Center"  VerticalAlignment="Center"   Foreground="#FFD54F"  Background="White" Width="60" Padding="4" TextAlignment="Center"  FontSize="20"  FontWeight="Bold" />
                        <TextBlock Grid.Row="1"  Grid.Column="0" Text="BlindScore" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>

                        <!--Displaying player chipscore nad hand name -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Background="#22354A" Grid.ColumnSpan="3"/>
                        <TextBlock x:Name="PlayerChipScore"  Grid.Row="2"  Grid.Column="1"  Text="Score"  Foreground="White"  HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="HandName" Grid.Row="2"  Grid.Column="0"  Text="HandName"   Foreground="White"  HorizontalAlignment="Center"   VerticalAlignment="Bottom"/>

                        <!--Backgrounds and colouring -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#1565C0" CornerRadius="6" Margin="2"/>
                        <Border Grid.Row="3" Grid.Column="1" Background="White" CornerRadius="6" Margin="2"/>
                        <Border Grid.Row="3" Grid.Column="2" Background="#C62828" CornerRadius="6" Margin="2"/>

                        <TextBlock x:Name="HandChipScore" Grid.Row="3"  Grid.Column="0" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="18"  Background="White" Width="50"/>

                        <TextBlock x:Name="HandMultScore" Grid.Row="3" Grid.Column="2" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="18" Background="White" Width="50"/>

                        <TextBlock Text="X" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                    </Grid>
                </Grid>
                <!--#endregion-->
                <!--#region Main card selection -->

                <!-- this is the content for the cards given to the player I really wanted to see what would be a good number to give the player and 8 cards seems the best out of testing -->
                <Border Grid.Column="1"
                        Grid.Row="2"
                        Background="#1D3142"
                        Margin="8,4"
                        CornerRadius="10" />

                <Grid Grid.Column="1" Grid.Row="3" Margin="8,4,8,8">
                    <Grid x:Name="CardGrid" Background="#33485B">
                        <!--Im going to leave it with 8 cards as its easier to do-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="HandCard1" Grid.Column="0" Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage1" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard2" Grid.Column="1"  Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage2" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard3" Grid.Column="2"  Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage3" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard4" Grid.Column="3" Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage4" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard5" Grid.Column="4" Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage5" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard6" Grid.Column="5" Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage6" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard7" Grid.Column="6" Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage7" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="HandCard8" Grid.Column="7" Click="Card_Click" Width="150" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="HandImage8" Stretch="Uniform" />
                        </Button>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12">
                            <Button x:Name="PlayHand" Content="Play Cards" Width="120" Margin="0,0,10,0" Background="#F1FF00" Click="PlayHand_Click"/>
                            <Button x:Name="Disguard" Content="Disguard" Width="120" Background="#F1FF00" Click="Disguard_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <!--#endregion-->
                <!-- This is a new grid inside of the main one-->

                <Grid x:Name="CardsPlayedGrid" Grid.Column="1" Grid.Row="2" Margin="20,20,20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1" CornerRadius="6">
                            <Image x:Name="PlayedImage1" />
                        </Border>
                        <Border x:Name="CardPlayed2" Grid.Column="3" CornerRadius="6">
                            <Image x:Name="PlayedImage2" />
                        </Border>
                        <Border x:Name="CardPlayed3" Grid.Column="5" CornerRadius="6">
                            <Image x:Name="PlayedImage3" />
                        </Border>
                        <Border x:Name="CardPlayed4" Grid.Column="7" CornerRadius="6">
                            <Image x:Name="PlayedImage4" />
                        </Border>
                        <Border x:Name="CardPlayed5" Grid.Column="9" CornerRadius="6">
                            <Image x:Name="PlayedImage5" />
                        </Border>
                    </Grid>
                </Grid>

                <!--This grid is for gameplay sake. This is for the chips the cards score.-->
                <Grid x:Name="ChipScoreGrid" Grid.Column="1" Grid.Row="1" Margin="20,0,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width=".5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ChipScore1" Grid.Column="1" Text="" VerticalAlignment="Bottom" Foreground="White" />
                        <TextBlock x:Name="ChipScore2" Grid.Column="3" Text="" VerticalAlignment="Bottom" Foreground="White" />
                        <TextBlock x:Name="ChipScore3" Grid.Column="5" Text="" VerticalAlignment="Bottom" Foreground="White" />
                        <TextBlock x:Name="ChipScore4" Grid.Column="7" Text="" VerticalAlignment="Bottom" Foreground="White" />
                        <TextBlock x:Name="ChipScore5" Grid.Column="9" Text="" VerticalAlignment="Bottom" Foreground="White" />
                    </Grid>
                </Grid>
            </Grid>



            <!-- Darkened background overlay -->
            <Border x:Name="ShopOverlayBackground"
                    Background="#88000000"
                    Visibility="Collapsed"
                    Panel.ZIndex="1090"
                    IsHitTestVisible="False" />

            <!-- Win screen overlay -->
            <Border x:Name="InitialWinScreen" Width="450"  Height="450" Background="#FF17182D" BorderBrush="#FFE6B800" BorderThickness="2" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="1400" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="You Win!" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFF1E240" />
                    <TextBlock Grid.Row="1" Text="Money Earned: " FontSize="18" HorizontalAlignment="Left"  Foreground="#FFD0B224" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MoneyEarnedDisplay"  Text="0" FontSize="18" HorizontalAlignment="Right" Foreground="#FFE29E0A" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Round Score:" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFD0B224" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RoundScoreDisplay" Text="0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFE29E0A" />
                    <Button Grid.Row="2" Grid.Column="1" Content="Continue" Width="120" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0" Click="ContinueFromWinScreen_Click" />
                </Grid>
            </Border>

            <!--Shop overlay.-->
            <Border x:Name="ShopOverLay" Width="650" Height="720" Background="#FF17182D" BorderBrush="#FF2E3E52" BorderThickness="2" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" Panel.ZIndex="1100" Padding="20" Margin="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition/>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Shop"  FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />

                    <StackPanel Grid.Row="1" Margin="0,20,0,20">
                        <TextBlock Text="Buy Jokers / Upgrades here" FontSize="18" Foreground="White" Margin="0,0,0,10" />

                        <Border Background="#FF131321" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="Joker1" Content="Buy Joker 1" Width="90" Height="145" Margin="8" Click="ClickedOnJokerShopCard" />
                                <Button x:Name="Joker2" Content="Buy Joker 2" Width="90" Height="145" Margin="8" Click="ClickedOnJokerShopCard" />
                                <Button x:Name="Joker3" Content="Buy Joker 3" Width="90" Height="145" Margin="8" Click="ClickedOnJokerShopCard" />
                                <Button x:Name="Joker4" Content="Buy Joker 4" Width="90" Height="145" Margin="8" Click="ClickedOnJokerShopCard" />
                            </WrapPanel>
                        </Border>

                        <Border Background="#FF131321" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Packs and cards" Foreground="White" Margin="0,0,0,8" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button x:Name="CardPack1" Content="Buy Pack 1" Width="90" Height="145" Margin="8" Click="ClickedOnArcanaShopCard" />
                                    <Button x:Name="CardPack2" Content="Buy Pack 2" Width="90" Height="145" Margin="8" Click="ClickedOnArcanaShopCard"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Name="PlayerMoneyDisplay"  Text="Money:"  FontSize="16"  VerticalAlignment="Center"  HorizontalAlignment="Left" Foreground="#FFFFEA00" />

                        <Button Grid.Column="1" Content="Continue"  Width="120" HorizontalAlignment="Right" Click="ContinueFromShop_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!--WinScreen overlay-->

            <!-- WIN SCREEN -->
            <Border x:Name="FinalWinScreen" Width="650" Height="720" Background="#FF17182D" BorderBrush="#FF2E3E52" BorderThickness="2" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" Panel.ZIndex="1100" Padding="20" Margin="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="YOU WIN"
                       Foreground="#FF6EF7A7"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
                        <TextBlock Text="Outstanding job! Here are your final results."
                       Foreground="#FFB8C7D9"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Score Summary -->
                    <Border Grid.Row="1"
                Background="#FF1F2638"
                BorderBrush="#FF32445B"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="PlayersFinalTotalScoreTxt" Text="Your Final Total Score :"
                               Foreground="#FFD6E4F0"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                                <Button x:Name="QuitGame" Content="Leave the game" Background="#FF671F1F" Click="QuitGame_Click"/>
                                <Button x:Name="KeepPlaying" Content="Keep Playing (momma didnt raise a quitter)" Background="#FF29B131" Click="KeepPlaying_Click"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                        Background="#22344A"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                                <TextBlock Text="Leaderboard"
                               Foreground="#FF9ED0FF"
                               FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Leaderboard -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0"
                    Background="#FF20283A"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Rank" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Player" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Score" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="Rounds" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="Date" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                     x:Name="PlayerNameList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#FF243247"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                            <Setter Property="Background" Value="#FFD4AF37"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rank}" Value="2">
                                            <Setter Property="Background" Value="#FFC0C0C0"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rank}" Value="3">
                                            <Setter Property="Background" Value="#FFB87333"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                CornerRadius="10"
                                Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                           Text="{Binding Rank}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                           Text="{Binding PlayerName}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2"
                                           Text="{Binding HighScore}"
                                           VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                           Text="{Binding RoundsLasted}"
                                           VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="4"
                                           Text="{Binding Date, StringFormat=d}"
                                           VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>


            <!-- LOSE SCREEN -->
            <Border x:Name="LoseScreen"
        Width="650"
        Height="720"
        Background="#FF17182D"
        BorderBrush="#FF2E3E52"
        BorderThickness="2"
        CornerRadius="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Visibility="Collapsed"
        Panel.ZIndex="1100"
        Padding="20"
        Margin="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="GAME OVER"
                       Foreground="#FFFF6B6B"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
                        <TextBlock Text="Better luck next time. Here are your final results."
                       Foreground="#FFB8C7D9"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Score Summary -->
                    <Border Grid.Row="1"
                Background="#FF1F2638"
                BorderBrush="#FF32445B"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="FinalLooseScoreTxt" Text="Your Final Score:"
                               Foreground="#FFD6E4F0"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                                <Button x:Name="NewGame" Content="New Game" Click="NewGame_Click" Background="#FFAF3232"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                        Background="#22344A"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                                <TextBlock Text="Leaderboard"
                               Foreground="#FF9ED0FF"
                               FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Leaderboard -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0"
                    Background="#FF20283A"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Rank" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Player" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Score" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="Rounds" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="Date" Foreground="#FF9FB3C8" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                     x:Name="LosePlayerNameList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#FF243247"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                            <Setter Property="Background" Value="#FFD4AF37"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rank}" Value="2">
                                            <Setter Property="Background" Value="#FFC0C0C0"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rank}" Value="3">
                                            <Setter Property="Background" Value="#FFB87333"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                CornerRadius="10"
                                Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                           Text="{Binding Rank}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                           Text="{Binding PlayerName}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2"
                                           Text="{Binding HighScore}"
                                           VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                           Text="{Binding RoundsLasted}"
                                           VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="4"
                                           Text="{Binding Date, StringFormat=d}"
                                           VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!--This is the animation layer from the tutorial, this allows all animations to happen on top. -->
            <Canvas x:Name="AnimationCanvas" Panel.ZIndex="1500" IsHitTestVisible="False" />

            <!--This is a joker card text/value once hovered over to compare joker card -->
            <Canvas x:Name="OverlayCanvas" Panel.ZIndex="1600">
                <Border x:Name="JokerHoverPopup" Background="#DD111111" BorderBrush="White" BorderThickness="1"  CornerRadius="6" Padding="8" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="JokerHoverText" Foreground="White" TextWrapping="Wrap" Width="180" />
                </Border>
                <Border x:Name="ArcanaHoverPopup" Background="#DD111111" BorderBrush="White" BorderThickness="1"  CornerRadius="6" Padding="8" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="ArcanaHoverText" Foreground="White" TextWrapping="Wrap" Width="180" />
                </Border>
                <Button x:Name="SellArcanaBtn"  Width="60" Height="28" Background="Green" Foreground="White" Content="Sell" Click="Sell_Arcana_Card" BorderBrush="White" Visibility="Collapsed" IsHitTestVisible="True"/>
                <Button x:Name="UseArcanaCardBtn" Width ="60" Height="28" Background="Yellow" Foreground="White" Content="Use" Click="Use_ArcanaCard" BorderBrush="Black" Visibility="Collapsed" IsHitTestVisible="true"/>
                <Button x:Name="SellJokerBtn" Width="60" Height="28" Background="Green" Foreground="White" Content="Sell" Click="SellJokerCard_Click" BorderBrush="White" Visibility="Collapsed" IsHitTestVisible="True"/>
            </Canvas>

        </Grid>
    </Grid>
</Page>